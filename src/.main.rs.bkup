            FFMPEG_DECODE_ARGS: vec!["-threads".to_string(), "0".to_string()],
            FFMPEG_MACOS_HWACCEL_ARGS: vec!["-hwaccel".to_string(), "videotoolbox".to_string()],
            FFMPEG_MACOS_ENCODER_ARGS: vec![
